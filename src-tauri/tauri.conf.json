{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "LAF Agent",
  "version": "0.1.1",
  "identifier": "com.lafco.lafagent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run dev:renderer",
    "beforeBuildCommand": "bun run build:renderer",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LAF Agent",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        },
        "transparent": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/prod/icon.png",
      "icons/prod/icon.icns",
      "icons/prod/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "LafAgent.entitlements"
    },
    "category": "DeveloperTool",
    "shortDescription": "AI coding agents on your desktop",
    "longDescription": "A native macOS desktop client for the prime-agent coding agent. Chat with agents, manage tasks, view diffs, and run terminals — all in one app.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQjVFODZBQzg4NjhENTgKUldSWWpZYklhdWkxWVltbXBSL0JuRUQ3VXpFM2N5eTJmZWtlT3dyOE41RVZjYzRvQTR1amtkYlUK",
      "endpoints": [
        "https://github.com/LAF-labs/prime/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": true
    }
  }
}
