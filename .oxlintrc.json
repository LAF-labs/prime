{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],

    // The automatic JSX runtime makes the React-17-era import rule noise.
    "react/react-in-jsx-scope": "off",

    // Stale-closure bugs are the single most common defect class in this
    // codebase's hooks, and every suppression here has to justify itself.
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",

    // Anything clickable must also be reachable from the keyboard.
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/no-autofocus": ["error", { "ignoreNonDOM": true }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "react-hooks/exhaustive-deps": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "src-tauri/target", "node_modules"]
}
